{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "permissions": {
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)",
      "Read(./secrets/**)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(git reset --hard:*)",
      "Bash(git rebase:*)",
      "Bash(git clean:*)",
      "Bash(rm:*)",
      "Bash(npm install:*)",
      "Bash(.venv/Scripts/python -m pip install:*)",
      "Bash(.venv/Scripts/python -m pip uninstall:*)"
    ]
  }
}
